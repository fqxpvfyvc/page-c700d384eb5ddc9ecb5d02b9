olumns:1fr 1fr;gap:0;border:1px solid var(--ink);background:var(--paper)}\n  .plan{padding:32px 28px;border-right:1px dashed var(--ink);position:relative}\n  .plan:last-child{border-right:none}\n  .plan.featured{background:var(--ink);color:var(--bg)}\n  .plan.featured .price,\n  .plan.featured h3{color:var(--bg)}\n  .plan.featured .features li,\n  .plan.featured .annual{color:#E6D8A6}\n  .plan.featured .features li::before{background:#E6D8A6}\n  .plan .badge{position:absolute;top:0;right:0;background:var(--accent);color:var(--ink);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:4px 10px}\n  .plan h3{font-size:26px;font-weight:800;margin-bottom:6px}\n  .plan .price{font-size:34px;font-weight:900;letter-spacing:-.01em;margin-bottom:4px}\n  .plan .annual{font-size:13px;color:var(--ink-soft);margin-bottom:22px;font-family:ui-monospace,Menlo,Consolas,monospace}\n  .plan .features{list-style:none;margin-bottom:22px}\n  .plan .features li{padding:8px 0 8px 20px;position:relative;font-size:14px;border-bottom:1px dotted rgba(27,58,31,.25)}\n  .plan .features li:last-child{border-bottom:none}\n  .plan .features li::before{content:\"\";position:absolute;left:0;top:14px;width:8px;height:8px;background:var(--ink)}\n  .plan .cta{display:inline-block;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;color:inherit;border-bottom:2px solid currentColor;padding-bottom:2px}\n\n  .plan-note{margin-top:18px;font-size:13px;color:var(--ink-soft);font-family:ui-monospace,Menlo,Consolas,monospace}\n\n  .faq{display:flex;flex-direction:column;gap:22px;max-width:760px}\n  .bubble{display:grid;grid-template-columns:80px 1fr;gap:16px;align-items:start}\n  .bubble .who{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);padding-top:10px}\n  .bubble .who::after{content:\"\";display:block;width:24px;height:1px;background:var(--ink-soft);margin-top:6px}\n  .bubble .body{background:var(--paper);border:1px solid var(--ink);padding:16px 20px;position:relative;font-size:15px}\n  .bubble.q .body{background:transparent;border:none;padding:0 0 0 0}\n  .bubble.q .body{font-weight:800;font-size:18px;border-left:3px solid var(--ink);padding:6px 0 6px 16px}\n  .bubble.a .body::before{content:\"\";position:absolute;left:-7px;top:18px;width:12px;height:12px;background:var(--paper);border-left:1px solid var(--ink);border-bottom:1px solid var(--ink);transform:rotate(45deg)}\n\n  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;counter-reset:step}\n  .step{border-top:2px solid var(--ink);padding-top:16px}\n  .step .sn{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;letter-spacing:.14em;color:var(--ink-soft);text-transform:uppercase;margin-bottom:8px}\n  .step h3{font-size:20px;margin-bottom:8px}\n  .step p{font-size:14px;color:var(--ink-soft)}\n\n  .clients{border:1px solid var(--ink);background:var(--paper);padding:28px;font-size:15px}\n  .clients h3{font-size:20px;margin-bottom:10px}\n  .clients ul{list-style:none}\n  .clients li{padding:10px 0;border-bottom:1px dotted var(--ink);display:flex;justify-content:space-between;gap:16px;align-items:baseline}\n  .clients li:last-child{border-bottom:none}\n  .clients .platform{font-weight:700}\n  .clients .note{color:var(--ink-soft);font-size:13px;font-family:ui-monospace,Menlo,Consolas,monospace}\n\n  footer{border-top:1px solid var(--ink);padding-top:20px;margin-top:40px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}\n  footer a{color:var(--ink-soft);text-decoration:none;border-bottom:1px dotted var(--ink-soft)}\n  footer a:hover{color:var(--ink);border-bottom-style:solid}\n\n  @media (max-width:760px){\n    .hero .lead,.hero .pull{grid-column:1 / span 12}\n    .hero .meta-row{grid-template-columns:repeat(2,1fr)}\n    .cards{grid-template-columns:1fr}\n    .plans{grid-template-columns:1fr}\n    .plan{border-right:none;border-bottom:1px dashed var(--ink)}\n    .plan:last-child{border-bottom:none}\n    .steps{grid-template-columns:1fr}\n    .bubble{grid-template-columns:60px 1fr}\n  }\n</style><div class=\"wrap\">\n  <nav class=\"crumb\" aria-label=\"breadcrumb\">\n    <a href=\"#\">首页</a>\n    <span class=\"sep\">/</span>\n    <a href=\"#\">产品</a>\n    <span class=\"sep\">/</span>\n    <span>UU</span>\n    <span class=\"live\">No.5794 · 奶油黄与墨绿</span>\n  </nav>\n  <nav class=\"toc\" aria-label=\"目录\">\n    <a href=\"#intro\">导言</a>\n    <a href=\"#why\">为什么选 UU</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#steps\">使用说明</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">常见问题</a>\n  </nav>\n\n  <header class=\"hero\">\n    <div class=\"masthead\">\n      <strong>UU</strong>\n      <span>Vol. 01 · 网络通道读本</span>\n    </div>\n    <h1>UU · 重新理解<br><em>你的网络通道</em></h1>\n    <p class=\"lead\">UU 不只是一个加速开关。它把流量、设备、线路与内容解锁拆成可读的参数，让你像翻阅一本说明书那样，看清楚每一次请求经过了什么、绕过了什么、又到达了什么。</p>\n    <p class=\"pull\">好的网络工具不会喊口号，它只会让你忘记它的存在——直到你关掉它，才发现世界变慢了。</p>\n    <div class=\"meta-row\">\n      <div><b>3</b>分级套餐</div>\n      <div><b>20</b>设备上限</div>\n      <div><b>1000GB</b>顶配流量</div>\n      <div><b>7×24</b>优先支持</div>\n    </div>\n  </header>\n\n  <main>\n    <section id=\"intro\">\n      <h2><span class=\"num\">§ 01</span>导言</h2>\n      <p class=\"lede\">我们习惯把网络当成空气：只要还在呼吸，就不会去想它从哪里来。UU 想做的，是给你一面镜子，让你看清这团空气的颗粒、湿度与温度。</p>\n      <p class=\"qa-intro\">那么，UU 到底是什么？往下读，答案会一层一层展开。</p>\n    </section>\n\n    <section id=\"why\">\n      <h2><span class=\"num\">§ 02</span>为什么是 UU</h2>\n      <p class=\"lede\">三个理由，足够说清楚我们和其他工具的分界线在哪里。</p>\n      <div class=\"cards\">\n        <article class=\"card\">\n          <span class=\"tag\">流量透明</span>\n          <h3>看得见的配额</h3>\n          <p>你买多少，就用多少。后台不玩模糊的“公平使用”条款，剩余流量、设备占用、当前线路状态全部在面板里直接显示。</p>\n          <span class=\"bignum\">01</span>\n        </article>\n        <article class=\"card\">\n          <span class=\"tag\">线路分层</span>\n          <h3>不同需求走不同路</h3>\n          <p>看剧、下载、游戏、办公，各自有匹配的节点池。旗舰版以上的 IPLC 专线为延迟敏感场景留出独立通道。</p>\n          <span class=\"bignum\">02</span>\n        </article>\n        <article class=\"card\">\n          <span class=\"tag\">多端在线</span>\n          <h3>设备不再互踢</h3>\n          <p>从基础版 3 台到团队版 20 台，同一账号下的设备可以并行使用，无需反复登出登录切换。</p>\n          <span class=\"bignum\">03</span>\n        </article>\n        <article class=\"card\">\n          <span class=\"tag\">内容解锁</span>\n          <h3>区域不是墙</h3>\n          <p>基础版覆盖常见流媒体，旗舰版及以上提供全节点原生解锁，让不同地区的正版内容回到它应有的观看体验里。</p>\n          <span class=\"bignum\">04</span>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"plans\">\n      <h2><span class=\"num\">§ 03</span>套餐</h2>\n      <p class=\"lede\">三档套餐，两栏对照。旗舰版为推荐档位，覆盖大多数个人用户的高频场景；团队版面向小型工作组和多人共享。</p>\n      <div class=\"plans\">\n        <article class=\"plan featured\">\n          <span class=\"badge\">推荐</span>\n          <h3>旗舰版</h3>\n          <div class=\"price\">¥35/月</div>\n          <div class=\"annual\">按年付仅需 ¥350/年</div>\n          <ul class=\"features\">\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <a class=\"cta\" href=\"#\">选择旗舰版 →</a>\n        </article>\n        <article class=\"plan\">\n          <h3>基础版</h3>\n          <div class=\"price\">¥15/月</div>\n          <div class=\"annual\">按年付仅需 ¥150/年</div>\n          <ul class=\"features\">\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <a class=\"cta\" href=\"#\">选择基础版 →</a>\n        </article>\n      </div>\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <h3>团队版</h3>\n          <div class=\"price\">¥85/月</div>\n          <div class=\"annual\">按年付仅需 ¥850/年</div>\n          <ul class=\"features\">\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <a class=\"cta\" href=\"#\">联系团队方案 →</a>\n        </article>\n        <article class=\"plan\">\n          <h3>不确定选哪档？</h3>\n          <p>如果你是第一次使用，建议从基础版起步，用一周时间观察流量消耗与线路体验，再决定是否升级到旗舰版或团队版。所有套餐均可按年续费，差价支持补档升级。</p>\n          <a class=\"cta\" href=\"#faq\">查看常见问题 →</a>\n        </article>\n      </div>\n      <p class=\"plan-note\">价格与权益以页面公示为准，不另设隐藏活动价。</p>\n    </section>\n\n    <section id=\"steps\">\n      <h2><span class=\"num\">§ 04</span>使用说明</h2>\n      <p class=\"lede\">从注册到第一次连接，通常不超过五分钟。</p>\n      <div class=\"steps\">\n        <article class=\"step\">\n          <div class=\"sn\">Step 01</div>\n          <h3>注册并选择套餐</h3>\n          <p>使用邮箱创建账号，选择基础版、旗舰版或团队版。完成支付后，流量与设备配额会立即写入账户。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"sn\">Step 02</div>\n          <h3>下载对应客户端</h3>\n          <p>在客户端区域选择与你设备匹配的版本。UU 不强制使用单一客户端，不同平台可使用各自的官方实现。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"sn\">Step 03</div>\n          <h3>导入并连接</h3>\n          <p>登录账号后，客户端会自动同步你的套餐与节点列表。选择目标节点，点击连接即可开始使用，无需手动配置参数。</p>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"clients\">\n      <h2><span class=\"num\">§ 05</span>客户端</h2>\n      <p class=\"lede\">UU 目前以订阅链接方式分发，适配主流平台。下列为常见可用平台，具体客户端以账户后台指引为准。</p>\n      <div class=\"clients\">\n        <h3>适配平台</h3>\n        <ul>\n          <li><span class=\"platform\">Windows</span><span class=\"note\">主流客户端可导入订阅</span></li>\n          <li><span class=\"platform\">macOS</span><span class=\"note\">主流客户端可导入订阅</span></li>\n          <li><span class=\"platform\">Android</span><span class=\"note\">主流客户端可导入订阅</span></li>\n          <li><span class=\"platform\">iOS / iPadOS</span><span class=\"note\">需通过地区账号获取客户端</span></li>\n          <li><span class=\"platform\">Linux</span><span class=\"note\">支持命令行与第三方 GUI</span></li>\n          <li><span class=\"platform\">路由器</span><span class=\"note\">支持 OpenWrt 等固件接入</span></li>\n        </ul>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <h2><span class=\"num\">§ 06</span>常见问题</h2>\n      <p class=\"qa-intro\">如果你还有疑问，下面这组对话或许能回答你最想问的那一句。</p>\n      <div class=\"faq\">\n        <div class=\"bubble q\">\n          <div class=\"who\">问 · 01</div>\n          <div class=\"body\">UU 和我手机里自带的 VPN 是一回事吗？</div>\n        </div>\n        <div class=\"bubble a\">\n          <div class=\"who\">答</div>\n          <div class=\"body\">不完全相同。UU 提供的是分级流量、多设备并行与分线路节点池，并附带流媒体解锁能力，通常面向需要稳定跨境访问与内容解锁的用户；手机自带 VPN 多为企业内网或基础加密场景设计。</div>\n        </div>\n\n        <div class=\"bubble q\">\n          <div class=\"who\">问 · 02</div>\n          <div class=\"body\">如果我这个月流量用完了，会怎样？</div>\n        </div>\n        <div class=\"bubble a\">\n          <div class=\"who\">答</div>\n          <div class=\"body\">当月流量耗尽后，连接会被限制速度或暂停，具体取决于套餐规则。你可以选择等待下月重置、补购流量包，或直接升级到更高档位套餐，差价按剩余周期折算。</div>\n        </div>\n\n        <div class=\"bubble q\">\n          <div class=\"who\">问 · 03</div>\n          <div class=\"body\">旗舰版和基础版的线路有什么实际差别？</div>\n        </div>\n        <div class=\"bubble a\">\n          <div class=\"who\">答</div>\n          <div class=\"body\">基础版使用普通线路节点池，满足日常浏览与基础流媒体观看；旗舰版提供全节点原生流媒体解锁，并额外配备 IPLC 专线，适合游戏加速、视频会议等对延迟敏感的场景。</div>\n        </div>\n\n        <div class=\"bubble q\">\n          <div class=\"who\">问 · 04</div>\n          <div class=\"body\">团队版的 20 台设备是同时在线，还是累计绑定？</div>\n        </div>\n        <div class=\"bubble a\">\n          <div class=\"who\">答</div>\n          <div class=\"body\">20 台指的是同时在线上限。你可以在更多设备上安装客户端并登录，但同时连接数超过上限时，最早建立的连接会被自动让位。</div>\n        </div>\n\n        <div class=\"bubble q\">\n          <div class=\"who\">问 · 05</div>\n          <div class=\"body\">支持退款吗？</div>\n        </div>\n        <div class=\"bubble a\">\n          <div class=\"who\">答</div>\n          <div class=\"body\">具体退款政策以购买页公示为准。一般情况下，新用户首次购买后在限定时间内且未大量使用流量时可申请退款；按年套餐的退款会按已使用月份折算。</div>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <span>© UU · 网络通道读本</span>\n    <span><a href=\"#plans\">套餐</a> · <a href=\"#faq\">FAQ</a> · <a href=\"#\">联系</a></span>\n  </footer>\n</div>",
